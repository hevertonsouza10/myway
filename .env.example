# Copie para .env.local (local) e cadastre os mesmos nomes na Vercel:
# Settings > Environment Variables. Nunca coloque valores reais neste arquivo.

# Token do canal: Anexo Chat > EMPRESAS > CANAIS > ⋮ > COPIAR TOKEN API
ANEXO_TOKEN=

# ID(s) da tag da etapa "Entrada" do funil, separados por vírgula.
# Para descobrir: node --env-file=.env.local scripts/anexo-setup.mjs
ANEXO_TAG_IDS=

# Opcional: abrir atendimento e mandar a 1ª mensagem no WhatsApp.
ANEXO_OPEN_CHAT=false
ANEXO_SECTOR_ID=
ANEXO_USER_ID=
# {nome} e {programa} são trocados pelos dados do candidato.
ANEXO_MENSAGEM=Olá {nome}! Recebemos sua candidatura para o {programa} da MyWay Treinamentos. Em breve nossa equipe fala com você por aqui.

# Opcional (precisa de ANEXO_OPEN_CHAT=true): ID do bloco "CRM · Localizar ou
# criar negócio" do fluxo. Depois da boas-vindas, o atendimento vai para esse
# bloco e o negócio é criado no CRM. O setup lista os IDs dos menus.
ANEXO_CRM_MENU_ID=

# Future integrations belong here. Never commit real secrets.
# DATABASE_URL=
# AUTH_SECRET=
# CMS_PROJECT_ID=
